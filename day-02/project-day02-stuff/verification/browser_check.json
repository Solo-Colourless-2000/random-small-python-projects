{
  "browser": "Chromium",
  "mode": "headless; loopback HTTP; standalone assets; file URLs blocked by environment browser policy",
  "desktop_viewport": [
    1440,
    1000
  ],
  "checks": {
    "all_10_chapters_navigate": true,
    "source_jump_and_return": true,
    "search_results_navigation": true,
    "progress_persists_on_reload": true,
    "font_wrap_focus_controls": true,
    "copy_payload_matches_snippet_without_line_numbers": true,
    "copy_test_uses_clipboard_stub": true,
    "svg_renders": true,
    "mobile_toc_and_chapter_buttons": true,
    "mobile_no_page_overflow": true,
    "all_20_chapters_visible_without_javascript": true
  },
  "chapter_overflow": [],
  "javascript_errors": []
}